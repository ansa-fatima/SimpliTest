DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# DB provisioning on container startup.
#
# By default the schema is synced from prisma/schema.prisma via `prisma db push`
# (non-destructive) — new tables/columns are created automatically on deploy.
#
# RUN_MIGRATIONS — apply the versioned migration files in prisma/migrations
# instead of the schema push, so schema/DB changes land through real migrations.
#   false (default): sync via `prisma db push` (non-destructive auto-sync).
#   true:            run `prisma migrate deploy` (applies every pending
#                    migration in order). On an existing DB that was created by
#                    `db push` and has no migration history, deploy can't
#                    baseline it, so startup falls back to a non-destructive
#                    `db push` automatically and logs it. Fresh databases get a
#                    proper _prisma_migrations history.
RUN_MIGRATIONS=false
#
# SEED_DATA — run the idempotent seed after the schema sync.
#   false (default): don't seed.
#   true:            run `prisma db seed` (upserts, skips existing rows — safe).
SEED_DATA=false

# RESET_DB — DESTRUCTIVE, opt-in. DROPs the public schema, rebuilds every table
# from schema.prisma, and re-seeds. ALL DATA IS LOST. Use to recover a corrupted
# DB or to clear old leftover columns that block the safe sync.
#   false (default): leave the database alone.
#   true:            wipe + rebuild + seed. Set true once, redeploy, then flip
#                    back to false — otherwise every deploy wipes the DB.
RESET_DB=false

# Optional: Google OAuth. Leave blank to hide the "Continue with Google" button.
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"


# ── AI test-case generation ("Generate with AI" on the Test cases page) ──────
# The normal way to set this up is IN THE APP: Settings > Integrations > AI Test
# Generation (choose a provider, paste its API key or server address, pick models).
# Nothing below is required. Providers: Claude, Gemini, OpenAI, OpenRouter, Groq,
# Grok (xAI), Mistral, DeepSeek, Ollama (local) and any OpenAI-compatible server.
#
# Optional server-wide fallback, used by any workspace that has not connected its own.
# The first one set below (in this order) is used:
# ANTHROPIC_API_KEY=""                       # Claude
# GEMINI_API_KEY=""                          # Gemini, from aistudio.google.com/apikey
# OPENAI_API_KEY=""                          # OpenAI
# OPENROUTER_API_KEY=""                      # OpenRouter
# GROQ_API_KEY=""                            # Groq
# XAI_API_KEY=""                             # Grok (xAI)
# MISTRAL_API_KEY=""                         # Mistral
# DEEPSEEK_API_KEY=""                        # DeepSeek
# OLLAMA_BASE_URL="http://localhost:11434"   # a local Ollama (no key needed)
# CUSTOM_AI_BASE_URL="http://localhost:1234" # any OpenAI-compatible server (+ optional CUSTOM_AI_API_KEY)
# AI_MODEL="claude-sonnet-5-5"               # must match the provider above, e.g. "gemini-flash-latest", "gpt-5-mini", "llama3.1"
# AI_TIEBREAK_MODEL="claude-haiku-5-5"
# <PROVIDER>_BASE_URL=...                    # only for a proxy / local mock, e.g. ANTHROPIC_BASE_URL, OPENAI_BASE_URL
#
# Optional: encrypt API keys saved in the app (16+ random characters). Without it
# they are stored like the Jira token. Set once and keep it -- changing it makes
# previously saved keys unreadable until they are re-entered.
# APP_ENCRYPTION_KEY=""
